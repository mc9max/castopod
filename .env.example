# === Castopod (web service) ===
# REQUIRED — public URL of this service (must end with /)
CP_BASEURL=https://your-castopod.up.railway.app/
# REQUIRED — 64-char random string (openssl rand -hex 32)
CP_ANALYTICS_SALT=change-me
# Optional — separate media domain (defaults to CP_BASEURL)
# CP_MEDIA_BASEURL=
# Optional — 2FA (true/false)
CP_ENABLE_2FA=false

# Database (auto-filled from mariadb companion service)
# CP_DATABASE_HOSTNAME=
# CP_DATABASE_NAME=castopod
# CP_DATABASE_USERNAME=castopod
# CP_DATABASE_PASSWORD=

# === MariaDB (database service) ===
# Generate a strong password (openssl rand -hex 16)
MYSQL_DATABASE=castopod
MYSQL_USER=castopod
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-differently
